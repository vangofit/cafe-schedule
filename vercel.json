{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/solve.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,demo/**,reference/**,engine/**,scripts/**,supabase/**,.next/**,app/**,components/**,lib/**,public/**}"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 18 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "backups": false
    }
  }
}